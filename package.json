{
  "name": "mcp-server-codechef",
  "version": "0.2.0",
  "description": "MCP server for CodeChef: profiles & analytics, contests & problems, sandboxed code execution, and submission with verdict tracking",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "mcp-server-codechef": "src/server.js",
    "codechef-mcp": "src/server.js"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "start": "node src/server.js",
    "test": "node test/unit.js && node test/workflow.js && node test/sandbox.js && node test/smoke.js && node test/mcp.js",
    "test:unit": "node test/unit.js && node test/workflow.js",
    "test:workflow": "node test/workflow.js",
    "test:sandbox": "node test/sandbox.js",
    "test:live": "node test/smoke.js",
    "test:mcp": "node test/mcp.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "codechef",
    "competitive-programming",
    "scraper",
    "llm"
  ],
  "author": "iamrudhresh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamrudhresh/mcp-server-codechef.git"
  },
  "homepage": "https://iamrudhresh.github.io/mcp-server-codechef/",
  "bugs": {
    "url": "https://github.com/iamrudhresh/mcp-server-codechef/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cheerio": "^1.2.0",
    "zod": "^4.6.7"
  }
}
