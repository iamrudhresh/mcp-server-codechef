# ============================================
# CodeChef Contest MCP Server — Configuration
# ============================================

# CodeChef account (only needed for submit_solution / get_submission_status).
# Accounts created with Google sign-in must first set a password at
# https://www.codechef.com/user/password
CODECHEF_USERNAME=your_codechef_username
CODECHEF_PASSWORD=your_codechef_password

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Sandbox Configuration
SANDBOX_MEMORY_LIMIT=256m
SANDBOX_CPU_LIMIT=1
SANDBOX_PID_LIMIT=64
COMPILE_TIMEOUT=10
EXECUTION_TIMEOUT=5
STRESS_TEST_TIMEOUT=15

# Solver Configuration
MAX_RETRIES=3
CONFIDENCE_THRESHOLD=75

# Redis (optional — falls back to in-memory cache)
REDIS_URL=redis://localhost:6379

# Database
DATABASE_URL=sqlite+aiosqlite:///./codechef_mcp.db
